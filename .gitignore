# Project
.gradle/
build/
**/build/
local.properties
*.iml
.idea/
.DS_Store
captures/
*.apk
*.aab
*.keystore
.cxx/
xcuserdata/
Pods/

# Detector models — third-party artifacts under their own licences, fetched per-machine.
# See androidApp/src/main/assets/models/README.md
androidApp/src/main/assets/models/*.tflite
androidApp/src/main/assets/models/*.bin
androidApp/src/main/assets/models/*.dlc

# QNN runtime libs — Qualcomm SDK redistributables, fetched per-machine.
# See androidApp/src/main/jniLibs/README.md
androidApp/src/main/jniLibs/**/*.so

# Qualcomm QAIRT SDK — vendor download, not redistributable, ~550 MB.
# Only the SDK itself; tools/restore-qairt.sh must stay in git, since it is what puts the
# SDK back after a reset. See androidApp/src/main/jniLibs/README.md
/tools/qairt/
