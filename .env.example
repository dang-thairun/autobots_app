# Upload backend — defaults the app loads on first run.
#
# Leave any value empty to have the operator fill it in on the Upload settings screen instead.
#
# The two URLs are re-applied from here on every launch, so this file decides which backend
# the build talks to. PLATFORM and EVENT_ID are only a starting point: once the app has a
# configuration stored, changing them here does nothing until it is cleared again.
#
# This is the committed template. Copy it to .env and fill in real values;
# .env itself is gitignored because UPLOAD_TOKEN is an admin credential.

# https://api.<host>/graphql — the photoUpload mutation lives here
UPLOAD_GRAPHQL_URL=

# https://upload.<host>/success — the completion call. Different host, form-encoded.
UPLOAD_COMPLETE_URL=

# x-runx-platform header value, e.g. thai
UPLOAD_PLATFORM=

# Which event the photos belong to. Usually left empty — the operator signs in and picks
# one from the dropdown, which is where this value normally comes from.
UPLOAD_EVENT_ID=

# Optional escape hatch. Normally EMPTY: the app signs in with username/password and holds
# the token in memory only. A token set here skips the login screen for this build, and is
# still never written to disk — reopening the app re-reads it from the build.
UPLOAD_TOKEN=
